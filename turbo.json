{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.shared"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "TERMINAL_PORT",
        "VITE_APP_SERVER_URL",
        "SITE_URL",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST",
        "PUBLIC_POSTHOG_KEY",
        "PUBLIC_POSTHOG_HOST"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
