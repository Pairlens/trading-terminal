{
  "name": "pairlens",
  "license": "FSL-1.1-Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pairlens/trading-terminal.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/terminal",
    "apps/marketing",
    "apps/desktop",
    "apps/registry",
    "apps/cli",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "postinstall": "bun scripts/setup-claude-preview.ts && bun scripts/setup-git-hooks.ts",
    "setup:preview": "bun scripts/setup-claude-preview.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/env/with-worktree-env.ts -- turbo run build",
    "build:terminal": "bun scripts/env/with-worktree-env.ts -- turbo run build --filter=@pairlens/terminal",
    "build:marketing": "bun scripts/env/with-worktree-env.ts -- turbo run build --filter=@pairlens/marketing",
    "typecheck": "bun scripts/env/with-worktree-env.ts -- turbo run typecheck",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ .",
    "i18n:scan": "bun scripts/i18n-scan.ts",
    "test": "bun scripts/env/with-worktree-env.ts -- turbo run test",
    "test:conformance": "bun test packages/plugins packages/market-engine",
    "conformance": "bun scripts/conformance.ts",
    "test:connectors:live": "PAIRLENS_LIVE_CONNECTORS=1 bun test packages/plugins/src/__tests__/live",
    "test:dex:testnet": "PAIRLENS_LIVE_TESTNET=1 bun test packages/plugins/src/__tests__/live/testnet.test.ts",
    "release": "bun scripts/release.ts",
    "license-headers": "bun scripts/license-headers.ts --check",
    "license-headers:fix": "bun scripts/license-headers.ts --fix",
    "create:plugin": "bun packages/create-pairlens-plugin/src/index.ts",
    "format": "prettier --write .",
    "dev:terminal": "bun scripts/env/with-worktree-env.ts -- turbo run dev --filter=@pairlens/terminal",
    "dev:marketing": "bun scripts/env/with-worktree-env.ts -- turbo run dev --filter=@pairlens/marketing",
    "dev:desktop": "bun scripts/dev.ts --desktop",
    "dev:registry": "bun scripts/env/with-worktree-env.ts -- turbo run dev --filter=@pairlens/registry"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pairlens/fast-financial-charts": "^1.5.3"
  },
  "patchedDependencies": {
    "ccxt@4.5.71": "patches/ccxt@4.5.71.patch"
  }
}
