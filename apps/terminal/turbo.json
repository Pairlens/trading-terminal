{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      // Everything Vite bakes into the client bundle. Turbo runs tasks in
      // strict env mode and this list REPLACES the root one, so a var that
      // is missing here is invisible to `vite build` — that is how a build
      // ends up shipping without an analytics key while dev has one. Listed
      // under `env` rather than passThroughEnv so changing a value busts the
      // cache instead of replaying a build that baked the old value.
      "env": [
        "MODE",
        "VITE_APP_SERVER_URL",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST",
        "VITE_EXTRA_PUBLISHER_KEYS"
      ],
      // The commit the build identifies itself by (see resolveBuildId in
      // vite.config.ts). passThroughEnv, not env: it changes on every commit,
      // so hashing it would bust this cache entry for every push that doesn't
      // touch the terminal. A replayed build is byte-identical to the one it
      // replaces, so shipping that build's id with it stays truthful.
      "passThroughEnv": ["VERCEL_GIT_COMMIT_SHA", "GITHUB_SHA"]
    }
  }
}
