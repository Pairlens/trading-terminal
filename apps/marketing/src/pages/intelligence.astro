          </a>
          <OsDownloadLink
            class="inline-flex h-[52px] items-center gap-[11px] whitespace-nowrap rounded-xl border border-border bg-background/40 px-6 text-[15.5px] font-semibold text-foreground transition-colors hover:bg-muted"
          />
