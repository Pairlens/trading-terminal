  </main>
  <SiteFooter />

  <!-- Subscribing happens inside the terminal (Settings → Intelligence opens
       the hosted checkout), so the plan CTAs explain the path instead of
       pretending the website can sell the plan. No-JS falls back to the hosted
       terminal, where Settings → Intelligence lives. -->
  <dialog
    data-plan-dialog-el
    aria-label="How to subscribe"
    class="plan-dialog m-auto w-[min(560px,calc(100vw-40px))] rounded-[22px] border border-border bg-card p-0 text-foreground"
  >
    <div class="p-8 sm:p-10">
      <p
        class="pl-eyebrow m-0"
        data-plan-dialog-plan
        style="color: var(--primary);"
      >
        Intelligence Pro
      </p>
      <h3
        class="m-0 mt-3 font-serif text-[27px] leading-[1.08] font-semibold tracking-[-0.02em]"
      >
        You subscribe from inside the terminal.
      </h3>
      <p class="m-0 mt-3.5 text-[15px] leading-relaxed text-muted-foreground">
        Billing is tied to your Pairlens account, so the plan is switched on
        where it runs. Three steps:
      </p>
      <ol class="m-0 mt-6 list-none space-y-4 p-0">
        {
          [
            {
              t: 'Open Pairlens',
              d: 'Launch it in your browser or open the desktop app; both are free. Already there? Skip ahead.',
            },
            {
              t: 'Sign in with your email',
              d: 'A one-time code, no password. The subscription follows this account onto every device.',
            },
            {
              t: 'Pick your plan in Settings → Intelligence',
              d: 'Checkout opens in your browser; the plan is live in the terminal the moment it completes.',
            },
          ].map((step, i) => (
            <li class="flex gap-3.5">
              <span class="grid size-7 shrink-0 place-items-center rounded-full border border-border font-mono text-[12px] font-semibold text-muted-foreground">
                {i + 1}
              </span>
              <div>
                <p class="m-0 text-[14.5px] font-semibold">{step.t}</p>
                <p class="m-0 mt-1 text-[13.5px] leading-relaxed text-muted-foreground">
                  {step.d}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={SITE.launchUrl}
          data-launch-terminal="intelligence-plan-dialog"
          class="inline-flex h-11 items-center rounded-xl bg-primary px-5 text-[14px] font-semibold text-primary-foreground transition-transform hover:scale-[1.03] active:scale-100"
        >
          Launch Pairlens free
        </a>
        <button
          type="button"
          data-plan-dialog-close
          class="inline-flex h-11 cursor-pointer items-center rounded-xl border border-border bg-transparent px-5 text-[14px] font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          Close
        </button>
      </div>
    </div>
  </dialog>

  <script>
    // Plan CTAs: intercept the launch-URL fallback and show the how-to dialog.
    function armPlanDialog() {
      const dialog = document.querySelector<HTMLDialogElement>(
        '[data-plan-dialog-el]',
      )
      if (!dialog || dialog.dataset.armed) return
      dialog.dataset.armed = '1'
      const planEl = dialog.querySelector<HTMLElement>('[data-plan-dialog-plan]')

      for (const cta of document.querySelectorAll<HTMLAnchorElement>(
        'a[data-plan-dialog]',
      )) {
        cta.addEventListener('click', (event) => {
          event.preventDefault()
          if (planEl) {
            planEl.textContent = cta.dataset.planDialog ?? ''
            planEl.style.color = cta.dataset.planAccent ?? 'var(--primary)'
          }
          dialog.showModal()
        })
      }
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
      dialog
        .querySelector('[data-plan-dialog-close]')
        ?.addEventListener('click', () => dialog.close())
    }
    armPlanDialog()
    document.addEventListener('astro:page-load', armPlanDialog)
  </script>

  <script is:inline>
    ;(() => {
      // Lead with the visitor's own platform; the other two stay one click away.
      function detect() {
        const ua = navigator.userAgent || ''
        const plat =
          (navigator.userAgentData && navigator.userAgentData.platform) ||
          navigator.platform ||
          ''
        // Phones and tablets can't install the terminal; the link already
        // points at /install, whose carry-on card explains the story. Modern
        // iPads report as Macintosh but expose multi-touch.
        if (
          (navigator.userAgentData && navigator.userAgentData.mobile) ||
          /android|iphone|ipod|ipad/i.test(ua) ||
          (/mac/i.test(plat) && navigator.maxTouchPoints > 1)
        ) {
          return 'mobile'
        }
        if (/win/i.test(plat) || /windows/i.test(ua)) return 'win'
        if (/linux|x11|cros/i.test(plat) || /linux|x11|cros/i.test(ua))
          return 'linux'
        return 'mac'
      }

      function apply() {
        const os = detect()
        for (const el of document.querySelectorAll('[data-os-face]')) {
          el.classList.toggle('is-on', el.getAttribute('data-os-face') === os)
        }
        for (const el of document.querySelectorAll('[data-os-alt]')) {
          el.classList.toggle('is-off', el.getAttribute('data-os-alt') === os)
        }
      }

      apply()
      if (!window.__plOsSwitchBound) {
        window.__plOsSwitchBound = true
        document.addEventListener('astro:page-load', apply)
      }
    })()
  </script>

  <style>
    /* Hero: copy against a bust that stands on the marble boundary. Stacks
       before the 300px minimum of the art column starts squeezing the copy. */
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 448px);
      gap: clamp(40px, 5vw, 72px);
      align-items: end;
    }
    .hero-bust {
      align-self: end;
      filter: drop-shadow(26px 34px 52px rgba(60, 50, 30, 0.34));
    }
    /* The bust is rendered by <Image>, so it never carries the scope hash. */
    .hero-bust :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }
    @media (max-width: 1000px) {
      .hero-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
      }
      .hero-bust {
        width: min(300px, 56%);
        justify-self: end;
      }
    }
    /* On a phone the bust has no boundary to stand on — it just floats under
       the copy, so it steps off entirely. The <Image> sizes attribute serves
       a 24px rendition at this width, so the hidden eager image is free. */
    @media (max-width: 720px) {
      .hero-bust {
        display: none;
      }
    }

    .band-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 56px;
    }
    @media (max-width: 860px) {
      .band-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
      }
    }

    /* Display type steps down with the shared breakpoint spec. */
    .hd-46 {
      font-size: 46px;
    }
    .hd-48 {
      font-size: 48px;
    }
    .hd-44 {
      font-size: 44px;
    }
    @media (max-width: 860px) {
      .hd-46 {
        font-size: 33px;
      }
      .hd-48 {
        font-size: 34px;
      }
      .hd-44 {
        font-size: 32px;
      }
    }
    @media (max-width: 480px) {
      .hd-46,
      .hd-48,
      .hd-44 {
        font-size: 30px;
      }
    }

    .plan-cta {
      transition: transform 0.2s var(--ease-out);
    }
    .plan-dialog::backdrop {
      background: rgb(0 0 0 / 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .plan-dialog[open] {
      animation: plan-dialog-in 0.3s var(--ease-out) both;
    }
    @keyframes plan-dialog-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .os-alt {
      transition:
        transform 0.2s var(--ease-out),
        border-color 0.2s ease;
    }
    .os-alt.is-off {
      display: none;
    }
    .os-alt-glyph {
      display: inline-flex;
    }
    .os-alt-glyph :global(svg) {
      width: 16px;
      height: 16px;
    }
    @media (hover: hover) {
      .plan-cta:hover,
      .os-alt:hover {
        transform: translateY(-2px);
      }
      /* Plan CTAs carry their border colour inline (per-card accent), so only
         the neutral OS links warm theirs on hover. */
      .os-alt:hover {
        border-color: color-mix(in oklch, var(--foreground) 28%, var(--border));
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .plan-dialog[open] {
        animation: none;
      }
      .plan-cta,
      .os-alt {
        transition: none;
      }
      .plan-cta:hover,
      .os-alt:hover {
        transform: none;
      }
    }
  </style>
</SiteLayout>
