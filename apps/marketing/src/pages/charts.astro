      letter-spacing: -0.026em;
    }
    @media (max-width: 860px) {
      .charts-d66 {
        font-size: 40px;
      }
      .charts-d46 {
        font-size: 33px;
      }
      .charts-d40 {
        font-size: 29px;
      }
      .charts-d34 {
        font-size: 26px;
      }
    }
    @media (max-width: 480px) {
      .charts-d66 {
        font-size: 36px;
      }
      .charts-d46 {
        font-size: 30px;
      }
    }

    .charts-code {
      color: color-mix(in oklch, var(--foreground) 88%, transparent);
    }
    /* Blank line between code stanzas — one line-height of the block. */
    .charts-code-gap {
      height: 21.5px;
    }

    .charts-copy-dashed {
      border-color: color-mix(in oklch, var(--border) 130%, transparent);
      background: color-mix(in oklch, var(--card) 60%, transparent);
      transition:
        border-color 0.2s var(--ease-out),
        background 0.2s var(--ease-out);
    }
    .charts-copy-dashed:hover {
      border-color: color-mix(in oklch, var(--foreground) 34%, transparent);
      background: var(--card);
    }
  </style>

  <style is:global>
    /* The skin bar re-points design tokens on each chart root, so the chrome
       inside one — labels, chips, rules, the price — re-skins with the canvas.
       Corners are a token too, on the roots that are cards in their own right;
       an attribute pair out-specifies the utility class that sets them. */
    [data-chart-root][data-skin-radius] {
      border-radius: var(--pl-skin-radius, 18px);
    }

    @media (prefers-reduced-motion: no-preference) {
      [data-chart-root] {
        transition:
          background-color 0.3s var(--ease-out),
          border-color 0.3s var(--ease-out),
          border-radius 0.3s var(--ease-out);
      }
    }

    /* Astro wraps every island in an <astro-island>, which is an unknown —
       therefore inline — element. Both rules below exist to get past it. */

    /* Island content is block-level (cards, grids), so the wrapper has to be.
       Astro also injects its hydration <style>/<script> as siblings inside the
       island wrapper — a bare `> *` would display:block those too, rendering
       the runtime source as page text. */
    .charts-island > astro-island {
      display: block;
    }

    /* The quick-start chart has to fill the grid row the code column sets, and
       the island wrapper Astro emits sits between the cell and the component —
       so the stretch has to be handed down explicitly. */
    .charts-chart-cell,
    .charts-chart-cell > astro-island,
    .charts-chart-cell > astro-island > * {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      min-height: 0;
    }
  </style>

  <script>
    import '@/scripts/reveal.ts'
  </script>

  <script is:inline>
    ;(() => {
      // Quick-start tabs: swap the code panel and tell the live pane which
      // snippet it is now running.
      function bindTabs() {
        for (const card of document.querySelectorAll('[data-code-card]')) {
          if (card.dataset.bound) continue
          card.dataset.bound = '1'
          card.addEventListener('click', (event) => {
            const tab = event.target.closest('[data-code-tab]')
            if (!tab) return
            const id = tab.getAttribute('data-code-tab')
            for (const other of card.querySelectorAll('[data-code-tab]')) {
              const on = other === tab
              other.setAttribute('aria-selected', on ? 'true' : 'false')
              other.classList.toggle('bg-muted', on)
              other.classList.toggle('text-foreground', on)
              other.classList.toggle('text-muted-foreground', !on)
              other.classList.toggle('hover:text-foreground', !on)
            }
            for (const panel of card.querySelectorAll('[data-code-panel]')) {
              panel.classList.toggle(
                'hidden',
                panel.getAttribute('data-code-panel') !== id,
              )
            }
            document.dispatchEvent(
              new CustomEvent('pairlens:charts-example', { detail: { id } }),
            )
          })
        }
      }

      // Copy buttons: the icon goes green for a beat, no layout change.
      function bindCopy() {
        for (const btn of document.querySelectorAll('[data-copy]')) {
          if (btn.dataset.bound) continue
          btn.dataset.bound = '1'
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(
                btn.getAttribute('data-copy') || '',
              )
            } catch {
              return
            }
            const icon = btn.querySelector('svg')
            if (!icon) return
            icon.style.color = 'var(--chart-2)'
            setTimeout(() => {
              icon.style.color = ''
            }, 1100)
          })
        }
      }

      function bind() {
        bindTabs()
        bindCopy()
      }
      bind()
      document.addEventListener('astro:page-load', bind)
    })()
  </script>
