// /terms — the document itself lives in src/content/legal/terms.mdx.
import { getEntry, render } from 'astro:content'
import LegalLayout from '@/layouts/LegalLayout.astro'

const entry = await getEntry('legal', 'terms')
if (!entry) throw new Error('Missing src/content/legal/terms.mdx')
const { Content, headings } = await render(entry)
---

<LegalLayout
  title={entry.data.title}
  description={entry.data.description}
  effective={entry.data.effective}
  summary={entry.data.summary}
  headings={headings}
  doc="terms"
  sourcePath="src/content/legal/terms.mdx"
>
  <Content />
</LegalLayout>
