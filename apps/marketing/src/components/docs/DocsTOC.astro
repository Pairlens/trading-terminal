import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  /** GitHub URL for the "Edit this page" link under the rail. */
  editUrl: string
}
const { headings, editUrl } = Astro.props
// Only surface H2s (and H3s indented) — keeps the rail scannable.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <nav aria-label="On this page" data-toc data-nav-loc="docs-toc">
      <p
        class="mb-3 font-mono text-[10px] font-semibold tracking-[0.2em] uppercase"
        style="color: color-mix(in oklch, var(--muted-foreground) 58%, transparent);"
      >
        On this page
      </p>
      <ul
        class="border-l"
        style="border-color: color-mix(in oklch, var(--border) 80%, transparent);"
      >
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={['pl-toc-link', h.depth === 3 && 'is-sub']}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<a
  href={editUrl}
  target="_blank"
  rel="noopener"
  class="mt-5 inline-flex items-center gap-[7px] font-mono text-[10.5px] font-semibold tracking-[0.14em] uppercase transition-colors hover:text-foreground"
  style="color: color-mix(in oklch, var(--muted-foreground) 78%, transparent);"
>
  <svg
    viewBox="0 0 16 16"
    fill="currentColor"
    aria-hidden="true"
    style="width: 13px; height: 13px;"
  >
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
    ></path>
  </svg>
  Edit this page
</a>

<style>
  .pl-toc-link {
    display: block;
    margin-left: -1px;
    border-left: 1px solid transparent;
    padding: 6px 0 6px 14px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted-foreground);
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .pl-toc-link.is-sub {
    padding-left: 26px;
  }
  .pl-toc-link:hover {
    color: var(--foreground);
  }
  .pl-toc-link.is-on {
    color: var(--foreground);
    border-left-color: var(--primary);
  }
</style>

<script>
  // Scroll-spy. The active heading only ever *changes* — it is never cleared,
  // because clearing it whenever nothing sits inside the band blanks the rail
  // at the top of the page and again between long sections.
  let observer: IntersectionObserver | null = null

  function setActive(slug: string) {
    for (const link of document.querySelectorAll<HTMLElement>('[data-toc-link]')) {
      link.classList.toggle('is-on', link.dataset.tocLink === slug)
    }
  }

  function arm() {
    observer?.disconnect()
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
    ]
    if (links.length === 0) return
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => el !== null)
    if (targets.length === 0) return

    const seen = new Set<string>()
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id)
          else seen.delete(entry.target.id)
        }
        const first = targets.find((t) => seen.has(t.id))
        if (first) setActive(first.id)
      },
      { rootMargin: '-120px 0px -68% 0px', threshold: 0 },
    )
    for (const target of targets) observer.observe(target)
    setActive(targets[0].id)

    for (const link of links) {
      if (link.dataset.bound) continue
      link.dataset.bound = '1'
      link.addEventListener('click', (event) => {
        const slug = link.dataset.tocLink ?? ''
        const el = document.getElementById(slug)
        if (!el) return
        event.preventDefault()
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
        window.scrollTo({
          top: el.getBoundingClientRect().top + window.scrollY - 118,
          behavior: reduced.matches ? 'auto' : 'smooth',
        })
        setActive(slug)
        history.replaceState(null, '', `#${slug}`)
      })
    }
  }

  arm()
  document.addEventListener('astro:page-load', arm)
</script>
