---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// The tier ladder, still on the hero's stone. Three cards answering the same
// three questions in the same order, with a slot meter drawn against the Gold
// cap so the venue counts compare visually, not just numerically. Caps are the
// real AFFILIATE_TIER_LIMITS values, read through content.ts.
import { SITE } from '@/lib/site'
import { MAX_CAP, TIERS } from './content'

const ROWS = [
  { key: 'audience', label: 'Who it’s for' },
  { key: 'requirement', label: 'What it takes' },
  { key: 'activation', label: 'How it unlocks' },
] as const
---

<section id="tiers" class="aff-tiers">
  <div class="mx-auto max-w-[1200px]">
    <div class="aff-tiers-head">
      <h2 class="aff-tiers-h2" data-reveal>
        Three tiers. The only thing that changes is how many venues you hold.
      </h2>
      <p class="aff-tiers-note" data-reveal data-reveal-delay="70">
        Bronze is the door being open. Silver and Gold arrive as a code from <a
          href={SITE.x}
          target="_blank"
          rel="noopener">@pairlens on X</a
        >, and unlock the moment you paste it into the form below.
      </p>
    </div>

    <div class="aff-tier-row">
      {
        TIERS.map((tier, i) => (
          <article class="aff-tier" data-reveal data-reveal-delay={120 + i * 70}>
            <div
              aria-hidden="true"
              class="aff-tier-rule"
              style={`background: ${tier.accent};`}
            />
            <div class="aff-tier-top">
              <p class="aff-tier-name">{tier.name}</p>
              <p class="aff-tier-badge">{tier.badge}</p>
            </div>

            <p class="aff-tier-cap">
              {tier.cap}
              <span>venue{tier.cap > 1 ? 's' : ''} max</span>
            </p>
            <div
              class="aff-tier-meter"
              role="img"
              aria-label={`${tier.cap} of ${MAX_CAP} possible venue slots`}
            >
              {Array.from({ length: MAX_CAP }, (_, slot) => (
                <span
                  class:list={['aff-tier-slot', slot < tier.cap && 'is-on']}
                  style={slot < tier.cap ? `background: ${tier.accent};` : ''}
                />
              ))}
            </div>

            <dl class="aff-tier-rows">
              {ROWS.map((row) => (
                <div class="aff-tier-fact">
                  <dt>{row.label}</dt>
                  <dd>{tier[row.key]}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .aff-tiers {
    padding: 0 32px 100px;
  }
  .aff-tiers-head {
    border-top: 2px solid color-mix(in oklch, var(--ml-fg) 22%, transparent);
    padding-top: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 56px;
    align-items: end;
  }
  .aff-tiers-h2 {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.034em;
    color: var(--ml-fg);
  }
  .aff-tiers-note {
    margin: 0 0 4px;
    font-size: 15.5px;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ml-muted);
  }
  .aff-tiers-note a {
    color: var(--ml-fg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--ml-fg) 28%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out);
  }
  .aff-tiers-note a:hover {
    text-decoration-color: var(--ml-fg);
  }

  .aff-tier-row {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .aff-tier {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--ml-border);
    background: var(--ml-card);
    padding: 26px 26px 24px;
    box-shadow: 0 22px 46px -38px rgba(60, 50, 30, 0.5);
  }
  .aff-tier-rule {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
  }
  .aff-tier-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .aff-tier-name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ml-fg);
  }
  .aff-tier-badge {
    margin: 0;
    border-radius: 9999px;
    border: 1px solid var(--ml-border);
    background: color-mix(in oklch, var(--ml-bg) 70%, transparent);
    padding: 5px 11px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in oklch, var(--ml-fg) 62%, transparent);
  }
  .aff-tier-cap {
    margin: 22px 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 54px;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.044em;
    color: var(--ml-fg);
  }
  .aff-tier-cap span {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ml-muted);
  }

  /* One slot per possible venue, filled up to the tier's cap — the three
     meters share a scale, so Bronze/Silver/Gold compare at a glance. */
  .aff-tier-meter {
    margin-top: 16px;
    display: flex;
    gap: 5px;
  }
  .aff-tier-slot {
    height: 7px;
    flex: 1;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--ml-fg) 11%, transparent);
  }

  .aff-tier-rows {
    margin: 22px 0 0;
    border-top: 1px solid var(--ml-border);
  }
  .aff-tier-fact {
    padding: 13px 0;
  }
  .aff-tier-fact + .aff-tier-fact {
    border-top: 1px solid color-mix(in oklch, var(--ml-border) 60%, transparent);
  }
  .aff-tier-fact dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--ml-fg) 48%, transparent);
  }
  .aff-tier-fact dd {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ml-muted);
  }

  @media (max-width: 1000px) {
    .aff-tiers-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      align-items: start;
    }
    .aff-tier-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
  @media (max-width: 860px) {
    .aff-tiers-h2 {
      font-size: 33px;
    }
  }
  @media (max-width: 720px) {
    .aff-tiers {
      padding: 0 20px 84px;
    }
  }
  @media (max-width: 480px) {
    .aff-tiers-h2 {
      font-size: 29px;
    }
    .aff-tier-cap {
      font-size: 46px;
    }
  }
</style>
