---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// Hero — the black "Zeus" arrival. A full-viewport black frame with the
// wordmark set behind the statue; both layers are sized from one custom
// property (--zs) so they always scale together. Scroll parallax comes from
// scripts/landing-fx.ts via [data-par]; the pointer tilt is local to this
// component (mouse only, damped, off on touch and under reduced motion).
import { Image, getImage } from 'astro:assets'
import zeusLens from '@/assets/zeus-lens.png'

// Phones get their own statue rendition: at 200vw on a 390-430px viewport the
// bust renders ~800-860 CSS px wide, and soft-focus marble tolerates a lower
// quality far better than a cellular link tolerates the full 1672w cut.
const statuePhone = await getImage({
  src: zeusLens,
  format: 'webp',
  width: 1250,
  quality: 58,
})
---

<section id="top" class="zhero">
  <div aria-hidden="true" class="pl-glow zhero-glow"></div>

  <h1 class="zhero-word" data-par="-34">Pairlens</h1>

  <picture>
    <source media="(max-width: 720px)" srcset={statuePhone.src} />
    <Image
      src={zeusLens}
      alt="A marble bust of Zeus wearing the Pairlens lens, prism light refracted across his eyes"
      class="zhero-statue"
      data-par="22"
      widths={[1250, 1672]}
      sizes="125vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="zhero-marks">
    <p>The<br />Open<br />Trading<br />Terminal</p>
    <div class="zhero-cue">
      <p>Scroll</p>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#fff"
        stroke-width="1.5"
        aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg
      >
    </div>
  </div>
</section>

<style is:global>
  /* The floating pill sits on pure black here — the marble-day shadow it
     ships with vanishes, so the landing deepens it. */
  [data-zeus-page] [data-site-hdr] .pl-hdr-pill {
    box-shadow: 0 16px 38px -22px rgba(0, 0, 0, 0.9);
  }
</style>

<style>
  .zhero {
    /* The statue image's width; the wordmark's size and seat both derive from
       it, so the word and the face never drift apart between breakpoints. */
    --zs: min(max(74vw, 128vh), 125vw);
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    background: #000;
  }

  .zhero-glow {
    pointer-events: none;
    position: absolute;
    left: 50%;
    top: 30%;
    width: 1150px;
    height: 640px;
    margin-left: -575px;
    border-radius: 9999px;
    filter: blur(130px);
    opacity: 0.3;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--primary) 40%, transparent),
      transparent
    );
    translate: var(--hx, 0px) var(--hy, 0px);
  }

  .zhero-word {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    /* 0.3485 puts the cap-band's centre (translateY(50%)) on the statue's
       mouth — measured from the reference composition. */
    bottom: calc(0.3485 * var(--zs));
    margin: 0;
    transform: translateY(50%);
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: min(calc(0.355 * var(--zs)), 26.5vw, 28rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: #fff;
    animation: zs-word 1.1s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }

  .zhero :global(.zhero-statue) {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    width: var(--zs);
    /* Tailwind preflight clamps img to max-width: 100%, which would silently
       kill the whole composition on narrow viewports. */
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 44px 76px rgba(0, 0, 0, 0.75));
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(180deg, #000 0, #000 93%, transparent 100%);
    animation: zs-statue 1.5s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }

  .zhero-marks {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 34px 30px;
    pointer-events: none;
  }
  .zhero-marks p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }
  .zhero-cue {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .zhero-cue svg {
    width: 17px;
    height: 17px;
    animation: zs-cue 2.2s var(--ease-inout) infinite;
  }

  @keyframes zs-word {
    from {
      opacity: 0;
      transform: translateY(50%) translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(50%);
    }
  }
  @keyframes zs-statue {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(30px) scale(1.03);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }
  @keyframes zs-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(5px);
      opacity: 0.85;
    }
  }

  /* Portrait phones cannot hold the landscape crop: the statue would swallow
     the wordmark. Widen the bust past the viewport and drop the word onto the
     laurel instead of across the face. */
  @media (max-width: 720px) and (orientation: portrait) {
    .zhero {
      --zs: 200vw;
    }
    .zhero-word {
      bottom: calc(0.548 * var(--zs) + 10px);
    }
    /* The wider bust fills the bottom of the frame, so the corner marks move
       up into the black above the wordmark rather than sitting on marble. */
    .zhero-marks {
      bottom: auto;
      top: 88px;
      align-items: flex-start;
      padding: 0 20px;
    }
  }

  /* On phones the statue IS the page: a 1.5s fade after the bytes arrive
     reads as the site still loading, not as choreography. Paint it the
     moment it decodes and keep the entry for fine-pointer devices.
     The blur/shadow passes go too — a 1150px layer under blur(130px) plus a
     76px drop shadow on a viewport-spanning statue is serious tile memory on
     a phone GPU, the shadow is invisible on the black ground anyway, and the
     radial gradient stays soft without the filter. */
  @media (pointer: coarse) {
    .zhero-word,
    .zhero :global(.zhero-statue) {
      animation: none;
    }
    .zhero :global(.zhero-statue) {
      filter: none;
    }
    .zhero-glow {
      filter: none;
      animation: none;
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zhero-word,
    .zhero :global(.zhero-statue),
    .zhero-cue svg {
      animation: none;
    }
  }
</style>

<script>
  // Pointer parallax: three hero layers drift at different depths, damped by
  // an rAF lerp. Mouse only — touch scroll would make the statue chase the
  // finger — and never under reduced motion. The statue moves on X only.
  function armZeusTilt() {
    const hero = document.querySelector<HTMLElement>('.zhero')
    if (!hero || hero.dataset.tilt) return
    hero.dataset.tilt = '1'
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(pointer: coarse)').matches
    ) {
      return
    }

    const layers: Array<[HTMLElement, number, number]> = []
    const word = hero.querySelector<HTMLElement>('.zhero-word')
    const statue = hero.querySelector<HTMLElement>('.zhero-statue')
    const glow = hero.querySelector<HTMLElement>('.zhero-glow')
    if (word) layers.push([word, -9, -5])
    if (statue) layers.push([statue, 16, 0])
    if (glow) layers.push([glow, 30, 14])

    let tx = 0
    let ty = 0
    let cx = 0
    let cy = 0
    let raf = 0

    const loop = () => {
      cx += (tx - cx) * 0.075
      cy += (ty - cy) * 0.075
      for (const [el, dx, dy] of layers) {
        el.style.setProperty('--hx', `${(cx * dx).toFixed(2)}px`)
        el.style.setProperty('--hy', `${(cy * dy).toFixed(2)}px`)
      }
      raf =
        Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002
          ? requestAnimationFrame(loop)
          : 0
    }
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop)
    }

    hero.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return
        const rect = hero.getBoundingClientRect()
        tx = ((event.clientX - rect.left) / rect.width) * 2 - 1
        ty = ((event.clientY - rect.top) / rect.height) * 2 - 1
        kick()
      },
      { passive: true },
    )
    hero.addEventListener(
      'pointerleave',
      () => {
        tx = 0
        ty = 0
        kick()
      },
      { passive: true },
    )
  }

  armZeusTilt()
  document.addEventListener('astro:page-load', armZeusTilt)
</script>
