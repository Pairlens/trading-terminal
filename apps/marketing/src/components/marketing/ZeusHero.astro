---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// Hero — the black "Zeus" arrival. A full-viewport black frame with the
// wordmark set behind the statue; both layers are sized from one custom
// property (--zs) so they always scale together. Scroll parallax comes from
// scripts/landing-fx.ts via [data-par]; the pointer tilt is local to this
// component (mouse only, damped, off on touch and under reduced motion).
import { Image, getImage } from 'astro:assets'
import { SITE } from '@/lib/site'
import zeusLens from '@/assets/zeus-lens.png'
import browserIcon from '@/components/marketing/os/browser.svg?raw'

// Phones get their own statue rendition: at 200vw on a 390-430px viewport the
// bust renders ~800-860 CSS px wide, and soft-focus marble tolerates a lower
// quality far better than a cellular link tolerates the full 1672w cut.
const statuePhone = await getImage({
  src: zeusLens,
  format: 'webp',
  width: 1250,
  quality: 58,
})
---

<section id="top" class="zhero">
  <div aria-hidden="true" class="pl-glow zhero-glow"></div>

  <h1 class="zhero-word" data-par="-34">Pairlens</h1>

  <picture>
    <source media="(max-width: 720px)" srcset={statuePhone.src} />
    <Image
      src={zeusLens}
      alt="A marble bust of Zeus wearing the Pairlens lens, prism light refracted across his eyes"
      class="zhero-statue"
      data-par="22"
      widths={[1250, 1672]}
      sizes="125vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <!-- The statue's own mask already fades its last 7% into the ground; this
       carries that fade further up the frame so the corner marks and the CTA
       always sit on black instead of on a lit marble shoulder. -->
  <div aria-hidden="true" class="zhero-scrim"></div>

  <!-- The one action of the landing page. It rides above the statue rather
       than in the marks rail so it keeps a single centred baseline at every
       width, and it is painted in glass so it reads over both the black
       ground and the lit marble underneath.
       The two labels are parallel by mechanism — browser vs desktop — rather
       than product vs platform: the product name is already set 400px tall
       behind the statue, so the button never has to repeat it. -->
  <div class="zhero-cta">
    <a
      href={SITE.launchUrl}
      class="zhero-launch"
      data-launch-terminal="landing-hero"
    >
      <span class="zhero-glyph" set:html={browserIcon} />
      Launch in browser
      <span class="zhero-tag">FREE</span>
    </a>
    <a href="/install" class="zhero-dl">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
        <path d="M5 21h14"></path>
      </svg>
      Download for desktop
    </a>
  </div>

  <div class="zhero-marks">
    <p>The<br />Open<br />Trading<br />Terminal</p>
    <div class="zhero-cue">
      <p>Scroll</p>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#fff"
        stroke-width="1.5"
        aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg
      >
    </div>
  </div>
</section>

<style is:global>
  /* The floating pill sits on pure black here — the marble-day shadow it
     ships with vanishes, so the landing deepens it. */
  [data-zeus-page] [data-site-hdr] .pl-hdr-pill {
    box-shadow: 0 16px 38px -22px rgba(0, 0, 0, 0.9);
  }
</style>

<style>
  .zhero {
    /* The statue image's width; the wordmark's size and seat both derive from
       it, so the word and the face never drift apart between breakpoints. */
    --zs: min(max(74vw, 128vh), 125vw);
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    background: #000;
  }

  .zhero-glow {
    pointer-events: none;
    position: absolute;
    left: 50%;
    top: 30%;
    width: 1150px;
    height: 640px;
    margin-left: -575px;
    border-radius: 9999px;
    filter: blur(130px);
    opacity: 0.3;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--primary) 40%, transparent),
      transparent
    );
    translate: var(--hx, 0px) var(--hy, 0px);
  }

  .zhero-word {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    /* 0.3485 puts the cap-band's centre (translateY(50%)) on the statue's
       mouth — measured from the reference composition. */
    bottom: calc(0.3485 * var(--zs));
    margin: 0;
    transform: translateY(50%);
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: min(calc(0.355 * var(--zs)), 26.5vw, 28rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: #fff;
    animation: zs-word 1.1s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }

  .zhero :global(.zhero-statue) {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    width: var(--zs);
    /* Tailwind preflight clamps img to max-width: 100%, which would silently
       kill the whole composition on narrow viewports. */
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 44px 76px rgba(0, 0, 0, 0.75));
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(180deg, #000 0, #000 93%, transparent 100%);
    animation: zs-statue 1.5s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }

  .zhero-scrim {
    pointer-events: none;
    position: absolute;
    z-index: 3;
    inset: auto 0 0;
    height: 250px;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(0 0 0 / 0.5) 46%,
      rgb(0 0 0 / 0.92)
    );
  }

  /* Sits on the marks' baseline, centred between the two corner rails. */
  .zhero-cta {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 30px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    animation: zs-cta 1.1s var(--ease-out) 0.45s both;
  }
  .zhero-launch,
  .zhero-dl {
    display: inline-flex;
    height: 52px;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    border-radius: 15px;
    padding: 0 24px;
    font-size: 15.5px;
    font-weight: 600;
    transition: transform 0.2s var(--ease-out);
  }
  .zhero-launch {
    background: #fff;
    color: #000;
  }
  .zhero-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }
  /* Browser frame on the launch button, download arrow on its sibling: the
     pair reads as "opens here" vs "saves to your machine" before either label
     is read. `set:html` content sits outside the scope attribute. */
  .zhero-glyph {
    display: inline-flex;
    opacity: 0.62;
  }
  .zhero-glyph :global(svg) {
    display: block;
    width: 17px;
    height: 17px;
  }
  /* Glass, not a flat tint: under the button is either pure black or a lit
     marble shoulder, and only a blurred backdrop holds both. */
  .zhero-dl {
    border: 1px solid rgb(255 255 255 / 0.24);
    background: rgb(0 0 0 / 0.34);
    color: #fff;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .zhero-dl svg {
    width: 17px;
    height: 17px;
    opacity: 0.75;
  }
  .zhero-launch:hover {
    color: #000;
    transform: translateY(-2px);
  }
  .zhero-dl:hover {
    color: #fff;
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.45);
  }
  .zhero-launch:focus-visible,
  .zhero-dl:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @keyframes zs-cta {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  .zhero-marks {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 34px 30px;
    pointer-events: none;
  }
  .zhero-marks p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }
  .zhero-cue {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .zhero-cue svg {
    width: 17px;
    height: 17px;
    animation: zs-cue 2.2s var(--ease-inout) infinite;
  }

  @keyframes zs-word {
    from {
      opacity: 0;
      transform: translateY(50%) translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(50%);
    }
  }
  @keyframes zs-statue {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(30px) scale(1.03);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }
  @keyframes zs-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(5px);
      opacity: 0.85;
    }
  }

  /* Two 52px buttons plus both corner rails stop fitting across the frame
     here; stacking keeps them centred and full-width-legible instead. */
  @media (max-width: 900px) {
    .zhero-cta {
      flex-direction: column;
      gap: 10px;
    }
    .zhero-launch,
    .zhero-dl {
      width: 272px;
      justify-content: center;
    }
    .zhero-scrim {
      height: 340px;
    }
  }

  /* Portrait phones cannot hold the landscape crop: the statue would swallow
     the wordmark. Widen the bust past the viewport and drop the word onto the
     laurel instead of across the face. */
  @media (max-width: 720px) and (orientation: portrait) {
    .zhero {
      --zs: 200vw;
    }
    .zhero-word {
      bottom: calc(0.548 * var(--zs) + 10px);
    }
    /* The wider bust fills the bottom of the frame, so the corner marks move
       up into the black above the wordmark rather than sitting on marble. */
    .zhero-marks {
      bottom: auto;
      top: 88px;
      align-items: flex-start;
      padding: 0 20px;
    }
  }

  /* On phones the statue IS the page: a 1.5s fade after the bytes arrive
     reads as the site still loading, not as choreography. Paint it the
     moment it decodes and keep the entry for fine-pointer devices.
     The blur/shadow passes go too — a 1150px layer under blur(130px) plus a
     76px drop shadow on a viewport-spanning statue is serious tile memory on
     a phone GPU, the shadow is invisible on the black ground anyway, and the
     radial gradient stays soft without the filter. */
  @media (pointer: coarse) {
    .zhero-word,
    .zhero-cta,
    .zhero :global(.zhero-statue) {
      animation: none;
    }
    .zhero :global(.zhero-statue) {
      filter: none;
    }
    .zhero-glow {
      filter: none;
      animation: none;
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zhero-word,
    .zhero-cta,
    .zhero :global(.zhero-statue),
    .zhero-cue svg {
      animation: none;
    }
    .zhero-launch,
    .zhero-dl {
      transition: none;
    }
    .zhero-launch:hover,
    .zhero-dl:hover {
      transform: none;
    }
  }
</style>

<script>
  // Pointer parallax: three hero layers drift at different depths, damped by
  // an rAF lerp. Mouse only — touch scroll would make the statue chase the
  // finger — and never under reduced motion. The statue moves on X only.
  function armZeusTilt() {
    const hero = document.querySelector<HTMLElement>('.zhero')
    if (!hero || hero.dataset.tilt) return
    hero.dataset.tilt = '1'
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(pointer: coarse)').matches
    ) {
      return
    }

    const layers: Array<[HTMLElement, number, number]> = []
    const word = hero.querySelector<HTMLElement>('.zhero-word')
    const statue = hero.querySelector<HTMLElement>('.zhero-statue')
    const glow = hero.querySelector<HTMLElement>('.zhero-glow')
    if (word) layers.push([word, -9, -5])
    if (statue) layers.push([statue, 16, 0])
    if (glow) layers.push([glow, 30, 14])

    let tx = 0
    let ty = 0
    let cx = 0
    let cy = 0
    let raf = 0

    const loop = () => {
      cx += (tx - cx) * 0.075
      cy += (ty - cy) * 0.075
      for (const [el, dx, dy] of layers) {
        el.style.setProperty('--hx', `${(cx * dx).toFixed(2)}px`)
        el.style.setProperty('--hy', `${(cy * dy).toFixed(2)}px`)
      }
      raf =
        Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002
          ? requestAnimationFrame(loop)
          : 0
    }
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop)
    }

    hero.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return
        const rect = hero.getBoundingClientRect()
        tx = ((event.clientX - rect.left) / rect.width) * 2 - 1
        ty = ((event.clientY - rect.top) / rect.height) * 2 - 1
        kick()
      },
      { passive: true },
    )
    hero.addEventListener(
      'pointerleave',
      () => {
        tx = 0
        ty = 0
        kick()
      },
      { passive: true },
    )
  }

  armZeusTilt()
  document.addEventListener('astro:page-load', armZeusTilt)
</script>
