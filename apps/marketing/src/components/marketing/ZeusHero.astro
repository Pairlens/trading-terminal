---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// Hero — the black "Zeus" arrival. A full-viewport black frame with the
// wordmark set behind the statue; both layers are sized from one custom
// property (--zs) so they always scale together. Scroll parallax comes from
// scripts/landing-fx.ts via [data-par]; the pointer tilt is local to this
// component (mouse only, damped, off on touch and under reduced motion).
import { Image, getImage } from 'astro:assets'
import { SITE } from '@/lib/site'
import zeusLens from '@/assets/zeus-lens.png'
import wordmark from '@/assets/wordmark.webp'

/** Logo files live in `public/browsers/` (vendor marks, via browser-logos). */
const BROWSERS = ['chrome', 'safari', 'edge', 'firefox', 'opera']

// Phones get their own statue rendition: at 200vw on a 390-430px viewport the
// bust renders ~800-860 CSS px wide, and soft-focus marble tolerates a lower
// quality far better than a cellular link tolerates the full 1672w cut.
const statuePhone = await getImage({
  src: zeusLens,
  format: 'webp',
  width: 1250,
  quality: 58,
})
---

<section id="top" class="zhero">
  <div aria-hidden="true" class="pl-glow zhero-glow"></div>

  <h1 class="zhero-word" data-par="-34">
    <img
      src={wordmark.src}
      alt="Pairlens"
      width={wordmark.width}
      height={wordmark.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      draggable="false"
    />
  </h1>

  <picture>
    <source media="(max-width: 720px)" srcset={statuePhone.src} />
    <Image
      src={zeusLens}
      alt="A marble bust of Zeus wearing the Pairlens lens, prism light refracted across his eyes"
      class="zhero-statue"
      data-par="22"
      widths={[1250, 1672]}
      sizes="125vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <!-- The statue's own mask already fades its last 7% into the ground; this
       carries that fade further up the frame so the corner marks and the CTA
       always sit on black instead of on a lit marble shoulder. -->
  <div aria-hidden="true" class="zhero-scrim"></div>

  <!-- The one action of the landing page. It rides above the statue rather
       than in the marks rail so it keeps a single centred baseline at every
       width, and it is painted in glass so it reads over both the black
       ground and the lit marble underneath.
       The two labels are parallel by mechanism — browser vs desktop — rather
       than product vs platform: the product name is already set 400px tall
       behind the statue, so the button never has to repeat it. -->
  <div class="zhero-cta">
    <div class="zhero-cta-row">
    <a
      href={SITE.launchUrl}
      class="zhero-launch"
      data-launch-terminal="landing-hero"
    >
      Launch in browser
      <span class="zhero-tag">FREE</span>
    </a>
    <a href="/install" class="zhero-dl">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
        <path d="M5 21h14"></path>
      </svg>
      Download for desktop
    </a>
    <!-- Phones get one action instead of two. The swap is CSS-only at the
         terminal's own 767px breakpoint, so the button a visitor sees and the
         shell they land on always agree, and nothing flashes the way a
         post-parse JS rewrite would. Analytics needs no change: the surface
         string segments it against the desktop-width hero on its own. -->
    <a
      href={SITE.launchUrl}
      class="zhero-mobile"
      data-launch-terminal="landing-hero-mobile"
    >
      Launch Mobile Terminal
      <span class="zhero-tag">FREE</span>
    </a>
    </div>

    <!-- Compatibility, not endorsement: the whole set says "any of these",
         which is also why no browser is detected — a stack can never show an
         Arc user the wrong logo. Served as five separate documents rather
         than inlined, because every one of these files defines `id="a"` and
         four reference `url(#a)`, so inlining them together would paint four
         logos with Chrome's gradient (and Safari's file carries an unscoped
         <style> that would leak `.b`/`.c` into the page). -->
    <p class="zhero-browsers">
      <span class="zhero-browsers-stack" aria-hidden="true">
        {
          BROWSERS.map((b) => (
            <img src={`/browsers/${b}.svg`} alt="" width="20" height="20" />
          ))
        }
      </span>
      Works in every modern browser
    </p>
  </div>

  <div class="zhero-marks">
    <p>The<br />Open<br />Trading<br />Terminal</p>
    <div class="zhero-cue">
      <p>Scroll</p>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#fff"
        stroke-width="1.5"
        aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg
      >
    </div>
  </div>
</section>

<style is:global>
  /* The floating pill sits on pure black here — the marble-day shadow it
     ships with vanishes, so the landing deepens it. */
  [data-zeus-page] [data-site-hdr] .pl-hdr-pill {
    box-shadow: 0 16px 38px -22px rgba(0, 0, 0, 0.9);
  }
</style>

<style>
  .zhero {
    /* The statue image's width; the wordmark's size and seat both derive from
       it, so the word and the face never drift apart between breakpoints. */
    --zs: min(max(74vw, 128vh), 125vw);
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    background: #000;
  }

  .zhero-glow {
    pointer-events: none;
    position: absolute;
    left: 50%;
    top: 30%;
    width: 1150px;
    height: 640px;
    margin-left: -575px;
    border-radius: 9999px;
    filter: blur(130px);
    opacity: 0.3;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--primary) 40%, transparent),
      transparent
    );
    translate: var(--hx, 0px) var(--hy, 0px);
  }

  .zhero-word {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    /* Seats the wordmark's letter band (translateY(50%)) on the statue's
       mouth. The seat is the image's centre, not its letters: the artwork
       carries the rainbow underline below the word, so the band it has to
       land on sits slightly above centre and the seat drops to compensate.
       Re-derived for the 5.18:1 mark (the 3.06:1 one seated at 0.315). */
    bottom: calc(0.312 * var(--zs));
    margin: 0;
    transform: translateY(50%);
    text-align: center;
    line-height: 0;
    animation: zs-word 1.1s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }
  .zhero-word img {
    display: inline-block;
    /* Matches the width the serif text wordmark used to span at each clamp
       stop. Tailwind preflight's max-width: 100% would crop the overshoot on
       narrow viewports, same as the statue below. */
    width: min(calc(1.31 * var(--zs)), 98vw, 102rem);
    max-width: none;
    height: auto;
    user-select: none;
  }

  .zhero :global(.zhero-statue) {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    width: var(--zs);
    /* Tailwind preflight clamps img to max-width: 100%, which would silently
       kill the whole composition on narrow viewports. */
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 44px 76px rgba(0, 0, 0, 0.75));
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(180deg, #000 0, #000 93%, transparent 100%);
    animation: zs-statue 1.5s var(--ease-out) both;
    translate: var(--hx, 0px) calc(var(--par-y, 0px) + var(--hy, 0px));
  }

  .zhero-scrim {
    pointer-events: none;
    position: absolute;
    z-index: 3;
    inset: auto 0 0;
    height: 250px;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(0 0 0 / 0.5) 46%,
      rgb(0 0 0 / 0.92)
    );
  }

  /* Sits on the marks' baseline, centred between the two corner rails. */
  .zhero-cta {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 30px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    animation: zs-cta 1.1s var(--ease-out) 0.45s both;
  }
  .zhero-cta-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .zhero-launch,
  .zhero-dl,
  .zhero-mobile {
    display: inline-flex;
    height: 52px;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    border-radius: 15px;
    padding: 0 24px;
    font-size: 15.5px;
    font-weight: 600;
    transition: transform 0.2s var(--ease-out);
  }
  /* The phone CTA is the same primary treatment as "Launch in browser", so it
     rides that button's rules rather than repeating them; only the display
     swap below is its own. */
  .zhero-launch,
  .zhero-mobile {
    background: #fff;
    color: #000;
  }
  .zhero-mobile {
    display: none;
  }
  /* A real chip rather than dimmed text: it reads as a badge without breaking
     the button's silhouette the way an overhanging corner ribbon would. */
  .zhero-tag {
    border-radius: 7px;
    background: rgb(0 0 0 / 0.09);
    padding: 3px 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .zhero-browsers {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }
  .zhero-browsers-stack {
    display: inline-flex;
    align-items: center;
  }
  /* Overlapped like an avatar stack. The ring is what makes that legible:
     without it five circular marks at this size fuse into one colourful blob,
     and past about -6px Edge and Firefox start losing their silhouettes. */
  .zhero-browsers-stack :global(img) {
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.65);
  }
  .zhero-browsers-stack :global(img + img) {
    margin-left: -6px;
  }
  /* Glass, not a flat tint: under the button is either pure black or a lit
     marble shoulder, and only a blurred backdrop holds both. */
  .zhero-dl {
    border: 1px solid rgb(255 255 255 / 0.24);
    background: rgb(0 0 0 / 0.34);
    color: #fff;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .zhero-dl svg {
    width: 17px;
    height: 17px;
    opacity: 0.75;
  }
  .zhero-launch:hover,
  .zhero-mobile:hover {
    color: #000;
    transform: translateY(-2px);
  }
  .zhero-dl:hover {
    color: #fff;
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.45);
  }
  .zhero-launch:focus-visible,
  .zhero-dl:focus-visible,
  .zhero-mobile:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @keyframes zs-cta {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  .zhero-marks {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 34px 30px;
    pointer-events: none;
  }
  .zhero-marks p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }
  .zhero-cue {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .zhero-cue svg {
    width: 17px;
    height: 17px;
    animation: zs-cue 2.2s var(--ease-inout) infinite;
  }

  @keyframes zs-word {
    from {
      opacity: 0;
      transform: translateY(50%) translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(50%);
    }
  }
  @keyframes zs-statue {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(30px) scale(1.03);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }
  @keyframes zs-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(5px);
      opacity: 0.85;
    }
  }

  /* Two 52px buttons plus both corner rails stop fitting across the frame
     here; stacking keeps them centred and full-width-legible instead. */
  @media (max-width: 900px) {
    .zhero-cta-row {
      flex-direction: column;
      gap: 10px;
    }
    .zhero-launch,
    .zhero-dl {
      width: 272px;
      justify-content: center;
    }
    .zhero-scrim {
      height: 380px;
    }
  }
  /* 767px is the terminal's own MOBILE_BREAKPOINT: below it the hosted
     terminal boots its phone shell, so the hero offers that one action and
     drops both desktop-width labels. It composes with the 900px rule above
     rather than fighting it — the column stack and the 380px scrim still
     apply, and the two hidden buttons take their 272px width with them, so
     the phone CTA restates it here as the only remaining child. */
  @media (max-width: 767px) {
    .zhero-launch,
    .zhero-dl {
      display: none;
    }
    .zhero-mobile {
      display: inline-flex;
      width: 272px;
      justify-content: center;
    }
  }
  /* The label alone would wrap beside the stack on a narrow phone. */
  @media (max-width: 420px) {
    .zhero-browsers {
      flex-direction: column;
      gap: 8px;
    }
  }

  /* Portrait phones cannot hold the landscape crop: the statue would swallow
     the wordmark. Widen the bust past the viewport and drop the word onto the
     laurel instead of across the face. */
  @media (max-width: 720px) and (orientation: portrait) {
    .zhero {
      --zs: 200vw;
    }
    .zhero-word {
      bottom: calc(0.548 * var(--zs) + 10px);
    }
    /* The wider bust fills the bottom of the frame, so the corner marks move
       up into the black above the wordmark rather than sitting on marble. */
    .zhero-marks {
      bottom: auto;
      top: 88px;
      align-items: flex-start;
      padding: 0 20px;
    }
    /* In this crop the wordmark straddles the statue box's top edge, and the
       mask clips the drop shadow at that edge (mask-clip: border-box), so the
       blurred silhouette ends in a hard seam right across the glyphs: white
       dims below the line, not above it. Coarse pointers already run without
       the filter; drop it for every pointer in this layout — on the pure-black
       ground the shadow buys nothing here. */
    .zhero :global(.zhero-statue) {
      filter: none;
    }
  }

  /* On phones the statue IS the page: a 1.5s fade after the bytes arrive
     reads as the site still loading, not as choreography. Paint it the
     moment it decodes and keep the entry for fine-pointer devices.
     The blur/shadow passes go too — a 1150px layer under blur(130px) plus a
     76px drop shadow on a viewport-spanning statue is serious tile memory on
     a phone GPU, the shadow is invisible on the black ground anyway, and the
     radial gradient stays soft without the filter. */
  @media (pointer: coarse) {
    .zhero-word,
    .zhero-cta,
    .zhero :global(.zhero-statue) {
      animation: none;
    }
    .zhero :global(.zhero-statue) {
      filter: none;
    }
    .zhero-glow {
      filter: none;
      animation: none;
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zhero-word,
    .zhero-cta,
    .zhero :global(.zhero-statue),
    .zhero-cue svg {
      animation: none;
    }
    .zhero-launch,
    .zhero-dl,
    .zhero-mobile {
      transition: none;
    }
    .zhero-launch:hover,
    .zhero-dl:hover,
    .zhero-mobile:hover {
      transform: none;
    }
  }
</style>

<script>
  // Pointer parallax: three hero layers drift at different depths, damped by
  // an rAF lerp. Mouse only — touch scroll would make the statue chase the
  // finger — and never under reduced motion. The statue moves on X only.
  function armZeusTilt() {
    const hero = document.querySelector<HTMLElement>('.zhero')
    if (!hero || hero.dataset.tilt) return
    hero.dataset.tilt = '1'
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(pointer: coarse)').matches
    ) {
      return
    }

    const layers: Array<[HTMLElement, number, number]> = []
    const word = hero.querySelector<HTMLElement>('.zhero-word')
    const statue = hero.querySelector<HTMLElement>('.zhero-statue')
    const glow = hero.querySelector<HTMLElement>('.zhero-glow')
    if (word) layers.push([word, -9, -5])
    if (statue) layers.push([statue, 16, 0])
    if (glow) layers.push([glow, 30, 14])

    let tx = 0
    let ty = 0
    let cx = 0
    let cy = 0
    let raf = 0

    const loop = () => {
      cx += (tx - cx) * 0.075
      cy += (ty - cy) * 0.075
      for (const [el, dx, dy] of layers) {
        el.style.setProperty('--hx', `${(cx * dx).toFixed(2)}px`)
        el.style.setProperty('--hy', `${(cy * dy).toFixed(2)}px`)
      }
      raf =
        Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002
          ? requestAnimationFrame(loop)
          : 0
    }
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop)
    }

    hero.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return
        const rect = hero.getBoundingClientRect()
        tx = ((event.clientX - rect.left) / rect.width) * 2 - 1
        ty = ((event.clientY - rect.top) / rect.height) * 2 - 1
        kick()
      },
      { passive: true },
    )
    hero.addEventListener(
      'pointerleave',
      () => {
        tx = 0
        ty = 0
        kick()
      },
      { passive: true },
    )
  }

  armZeusTilt()
  document.addEventListener('astro:page-load', armZeusTilt)
</script>
