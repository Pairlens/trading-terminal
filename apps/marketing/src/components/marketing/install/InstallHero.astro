---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// /install arrival: marble ground, a facts rail, the web lane, and the three
// OS tiles that drive the rest of the page. Rendered with macOS selected so
// the page is complete without JS; the page script re-selects the detected
// platform and badges it "Your system". The tiles ARE the download — each is
// a direct link to its installer alias, as is the big button. A click hands
// the hero to the "download started" card (scripts/install-flow.ts) while the
// inline page script keeps selection state in sync.
//
// The web lane sits above the tiles on purpose: the fastest way into the
// terminal is not installing it, and someone who came here to download still
// has the whole chooser directly underneath.
import { INSTALLERS, SITE } from '@/lib/site'
import { DEFAULT_OS, OS_GUIDES } from './os-guides'
import appleIcon from '@/components/marketing/os/apple.svg?raw'
import windowsIcon from '@/components/marketing/os/windows.svg?raw'
import linuxIcon from '@/components/marketing/os/linux.svg?raw'

const OS_ICON: Record<string, string> = {
  apple: appleIcon,
  windows: windowsIcon,
  linux: linuxIcon,
}

// Each mark is drawn at its own optical size. Written as literal utility
// strings so Tailwind sees them; the raw SVG is injected, so a scoped
// `> svg` rule would never reach it.
const OS_GLYPH: Record<string, string> = {
  apple: '[&>svg]:size-[24px]',
  windows: '[&>svg]:size-[21px]',
  linux: '[&>svg]:size-[23px]',
}

const FACTS = [
  { label: 'Price', value: 'Free forever' },
  { label: 'Account', value: 'Not required' },
  { label: 'License', value: 'Source-available' },
  { label: 'Updates', value: 'Automatic' },
]

const ALTS = Object.fromEntries(INSTALLERS.map((it) => [it.os, it.alts]))
/** DEFAULT_OS is a literal type; widen so per-OS comparisons typecheck. */
const isDefault = (os: string) => os === (DEFAULT_OS as string)

const defaultHref =
  INSTALLERS.find((it) => it.os === DEFAULT_OS)?.href ??
  `${SITE.repo}/releases/latest`
---

<section class="pl-marble ins-hero">
  <div class="mx-auto max-w-[1200px]">
    <div class="ins-rail">
      <div>
        <p class="pl-eyebrow ins-eyebrow" data-reveal>
          Get Pairlens · Browser · macOS · Windows · Linux
        </p>
        <h1 class="ins-h1" data-reveal data-reveal-delay="70">
          It runs on your desk, not ours.
        </h1>
        <p class="ins-lede" data-reveal data-reveal-delay="140">
          Open it in your browser and start in seconds, or install the desktop
          build for the full local experience. No account either way, and every
          build ships from public CI and keeps itself up to date.
        </p>
      </div>

      <dl class="ins-facts" data-reveal data-reveal-delay="200">
        {
          FACTS.map((fact) => (
            <div class="ins-fact">
              <dt class="ins-fact-label">{fact.label}</dt>
              <dd class="ins-fact-value">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="ins-web" data-reveal data-reveal-delay="220">
      <div class="ins-web-copy">
        <p class="ins-web-eyebrow">Nothing to install</p>
        <p class="ins-web-title">Run Pairlens in your browser.</p>
        <p class="ins-web-body">
          The same terminal, the same connectors, the same AI assistant. Your
          keys are encrypted on your own device and never reach a Pairlens
          server.
        </p>
      </div>
      <a
        href={SITE.launchUrl}
        class="ins-web-cta"
        data-launch-terminal="install-hero"
      >
        Launch the terminal
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <p class="ins-or" data-reveal data-reveal-delay="230">
      <span>or install the desktop app</span>
    </p>

    <div role="group" aria-label="Choose your platform" class="ins-tiles">
      {
        INSTALLERS.map((it, i) => (
          <div class="ins-tile-wrap" data-reveal data-reveal-delay={240 + i * 60}>
            <a
              href={it.href}
              class:list={['ins-tile', it.os === DEFAULT_OS && 'is-sel']}
              data-os-tile={it.os}
              data-os-href={it.href}
              data-os-download="install-tile"
              data-os={it.os}
              aria-label={`Download Pairlens for ${it.os}`}
            >
              <span class="ins-tile-top">
                <span
                  class:list={['ins-glyph', OS_GLYPH[it.icon]]}
                  set:html={OS_ICON[it.icon]}
                />
                <span class="ins-you">Your system</span>
              </span>
              <span class="ins-tile-name">{it.os}</span>
              <span class="ins-tile-sub">{it.tagline}</span>
              <span class="ins-chips">
                {it.formats.map((f) => (
                  <span class="ins-chip">{f}</span>
                ))}
              </span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="ins-cta" data-reveal data-reveal-delay="420">
      <!-- `data-os-cta` is what the platform chooser rewrites. It cannot key
           off `[data-os-download]`: the OS tiles above carry that too and come
           first in the DOM, so the chooser would repoint the macOS tile and
           leave this button on the default build. -->
      <a
        class="pl-ring ins-download"
        data-os-download="install-cta"
        data-os-cta
        href={defaultHref}
      >
        <svg
          class="ins-download-ic"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
          <path d="M5 21h14"></path>
        </svg>
        <span>Download for <span data-os-name>{DEFAULT_OS}</span></span>
      </a>
      <div>
        <p class="ins-cta-sub">
          {
            INSTALLERS.map((it) => (
              <span
                class:list={['ins-sub', it.os === DEFAULT_OS && 'is-active']}
                data-os-sub={it.os}
              >
                {OS_GUIDES[it.os]?.sub}
              </span>
            ))
          }
        </p>
        <p class="ins-cta-note">
          <span
            class:list={['ins-sub', isDefault('macOS') && 'is-active']}
            data-os-sub="macOS"
          >
            On an Intel Mac? <a class="ins-link" href={ALTS['macOS'][0].href}
              >Download the Intel build</a
            >.{' '}
          </span>
          <span
            class:list={['ins-sub', isDefault('Windows') && 'is-active']}
            data-os-sub="Windows"
          >
            Prefer the Windows installer format? <a
              class="ins-link"
              href={ALTS['Windows'][0].href}>Get the .msi</a
            >.{' '}
          </span>
          <span
            class:list={['ins-sub', isDefault('Linux') && 'is-active']}
            data-os-sub="Linux"
          >
            Debian or Fedora native? <a
              class="ins-link"
              href={ALTS['Linux'][0].href}>.deb</a
            > · <a class="ins-link" href={ALTS['Linux'][1].href}>.rpm</a>.{' '}
          </span>
          Need a checksum, an older build or the changelog? <a
            class="ins-link"
            href={`${SITE.repo}/releases`}
            target="_blank"
            rel="noopener">Browse all releases</a
          >.
        </p>
      </div>
    </div>

    <!-- Takes the chooser's place once a download starts: confirmation, a
         retry link, the sibling formats, and the way back. Shown by
         scripts/install-flow.ts via `.is-downloaded` on the page root. -->
    <div class="ins-started" data-dl-started>
      <p class="ins-started-eyebrow">Download started</p>
      <p class="ins-started-title">
        Pairlens for <span data-dl-os>{DEFAULT_OS}</span> is on its way.
      </p>
      <p class="ins-started-body">
        Keep this page open: your install steps are right below. Didn’t
        start? <a class="ins-link" data-dl-retry href={defaultHref}
          >Download again</a
        >.
      </p>
      <p class="ins-started-alt">
        <span
          class:list={['ins-sub', isDefault('macOS') && 'is-active']}
          data-os-sub="macOS"
        >
          On an Intel Mac? <a class="ins-link" href={ALTS['macOS'][0].href}
            >Grab the Intel build</a
          > instead.
        </span>
        <span
          class:list={['ins-sub', isDefault('Windows') && 'is-active']}
          data-os-sub="Windows"
        >
          Prefer the Windows installer format? <a
            class="ins-link"
            href={ALTS['Windows'][0].href}>Get the .msi</a
          > instead.
        </span>
        <span
          class:list={['ins-sub', isDefault('Linux') && 'is-active']}
          data-os-sub="Linux"
        >
          Debian or Fedora native? Take the <a
            class="ins-link"
            href={ALTS['Linux'][0].href}>.deb</a
          > or the <a class="ins-link" href={ALTS['Linux'][1].href}>.rpm</a>
          instead.
        </span>
      </p>
      <button type="button" class="ins-started-back" data-dl-back>
        ← Choose a different system
      </button>
    </div>

    <!-- Swapped in for the download CTA on phones: there is nothing to
         install there, so the useful action is carrying the link to a desk. -->
    <div class="ins-mobile" data-reveal data-reveal-delay="420">
      <p class="ins-mobile-eyebrow">You’re on a phone</p>
      <p class="ins-mobile-title">The installers need a desk.</p>
      <p class="ins-mobile-body">
        The desktop build is for macOS, Windows and Linux, so there’s nothing
        to install here. The web terminal above opens right where you are.
        Send yourself this page to set up the desktop app later.
      </p>
      <div class="ins-mobile-row">
        <button type="button" class="ins-mobile-copy" data-mobile-copy>
          <span class="ins-mobile-copy-idle">Copy link</span>
          <span class="ins-mobile-copy-done">Link copied ✓</span>
        </button>
        <button type="button" class="ins-mobile-share" data-mobile-share hidden>
          Share…
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .ins-hero {
    padding: 150px 32px 96px;
  }

  .ins-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 72px;
    align-items: start;
  }

  .ins-eyebrow {
    margin: 0;
    color: var(--ml-muted);
  }
  .ins-h1 {
    margin: 28px 0 0;
    max-width: 15ch;
    font-family: var(--font-serif);
    font-size: 88px;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.044em;
    color: var(--ml-fg);
  }
  .ins-lede {
    margin: 32px 0 0;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ml-muted);
  }

  /* Facts rail — a hairline column that becomes a hairline band once stacked. */
  .ins-facts {
    margin: 0;
    border-left: 1px solid var(--ml-border);
    padding-left: 32px;
  }
  .ins-fact {
    padding: 14px 0;
    border-bottom: 1px solid var(--ml-border);
  }
  .ins-fact-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--ml-fg) 42%, transparent);
  }
  .ins-fact-value {
    margin: 6px 0 0;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ml-fg);
  }

  /* The web lane. Iris-tinted so it reads as the recommended door without
     shouting over the marble, and wide enough that the copy and the button
     share one line on a desk. */
  .ins-web {
    margin-top: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    border-radius: 22px;
    border: 1px solid color-mix(in oklch, var(--primary) 34%, var(--ml-border));
    background: linear-gradient(
      100deg,
      color-mix(in oklch, var(--primary) 11%, var(--ml-card)),
      var(--ml-card) 62%
    );
    padding: 26px 28px;
    box-shadow: 0 24px 50px -38px oklch(0.24 0.012 66 / 0.55);
  }
  .ins-web-copy {
    min-width: 0;
  }
  .ins-web-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .ins-web-title {
    margin: 9px 0 0;
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.022em;
    color: var(--ml-fg);
  }
  .ins-web-body {
    margin: 7px 0 0;
    max-width: 58ch;
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--ml-muted);
  }
  .ins-web-cta {
    display: inline-flex;
    flex: none;
    height: 54px;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    border-radius: 15px;
    background: var(--primary);
    padding: 0 24px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--primary-foreground);
    transition: transform 0.2s var(--ease-out);
  }
  .ins-web-cta:hover {
    color: var(--primary-foreground);
    transform: translateY(-2px);
  }
  .ins-web-cta svg {
    width: 18px;
    height: 18px;
  }

  /* Hairline rule with the label sitting in the gap. */
  .ins-or {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 42px 0 0;
  }
  .ins-or::before,
  .ins-or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--ml-border);
  }
  .ins-or span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--ml-fg) 48%, transparent);
  }

  .ins-tiles {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  /* The reveal animation fills forwards, so it would win over the tile's own
     hover transform — reveal the wrapper and leave the button free to lift. */
  .ins-tile-wrap {
    display: flex;
  }
  .ins-tile {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    border-radius: 20px;
    padding: 20px 24px 22px;
    border: 1px solid var(--ml-border);
    background: color-mix(in oklch, var(--ml-card) 66%, transparent);
    transition:
      transform 0.26s var(--ease-out),
      border-color 0.26s var(--ease-out),
      background 0.26s var(--ease-out),
      box-shadow 0.26s var(--ease-out);
  }
  .ins-tile:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklch, var(--ml-fg) 20%, var(--ml-border));
  }
  .ins-tile:focus-visible {
    outline: 2px solid var(--ml-fg);
    outline-offset: 3px;
  }
  .ins-tile.is-sel {
    background: var(--ml-card);
    box-shadow:
      inset 0 0 0 1.5px color-mix(in oklch, var(--ml-fg) 32%, transparent),
      0 22px 46px -32px rgba(60, 50, 30, 0.62);
  }

  .ins-tile-top {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .ins-glyph {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    border: 1px solid var(--ml-border);
    background: color-mix(in oklch, var(--ml-bg) 60%, transparent);
    color: var(--ml-fg);
  }
  .ins-you {
    display: none;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--ml-fg) 26%, transparent);
    padding: 4px 9px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-fg);
  }
  .ins-tile.is-you .ins-you {
    display: inline-flex;
  }
  .ins-tile-name {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.024em;
    color: var(--ml-fg);
  }
  .ins-tile-sub {
    margin-top: 4px;
    font-size: 14.5px;
    color: var(--ml-muted);
  }
  .ins-chips {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ins-chip {
    border-radius: 7px;
    border: 1px solid var(--ml-border);
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ml-muted);
  }

  .ins-cta {
    margin-top: 32px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 26px;
  }

  /* Download-started card: hidden until install-flow.ts stamps
     `.is-downloaded` on the page root, then it takes the chooser's place. */
  .ins-started {
    display: none;
    margin-top: 32px;
    max-width: 560px;
    border-radius: 18px;
    border: 1px solid var(--ml-border);
    background: var(--ml-card);
    padding: 26px 28px;
    box-shadow: 0 22px 46px -38px rgba(60, 50, 30, 0.5);
  }
  :global([data-install-page].is-downloaded) .ins-tiles,
  :global([data-install-page].is-downloaded) .ins-cta {
    display: none;
  }
  :global([data-install-page].is-downloaded) .ins-started {
    display: block;
    animation: ins-started-rise 0.45s var(--ease-out) both;
  }
  @keyframes ins-started-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .ins-started-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pl-green, #3f9d63);
  }
  .ins-started-title {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ml-fg);
  }
  .ins-started-body,
  .ins-started-alt {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--ml-muted);
  }
  .ins-started-back {
    margin-top: 18px;
    display: inline-flex;
    height: 42px;
    align-items: center;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid var(--ml-border);
    background: color-mix(in oklch, var(--ml-card) 70%, transparent);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--ml-fg);
    cursor: pointer;
  }
  .ins-started-back:hover {
    border-color: color-mix(in oklch, var(--ml-fg) 20%, var(--ml-border));
  }

  /* Phone path: the JS stamps `.is-mobile` on the page root and this card
     replaces the download row. Hidden by default so desktop and no-JS keep
     the normal CTA. */
  .ins-mobile {
    display: none;
    margin-top: 32px;
    max-width: 520px;
    border-radius: 18px;
    border: 1px solid var(--ml-border);
    background: var(--ml-card);
    padding: 24px 26px;
    box-shadow: 0 22px 46px -38px rgba(60, 50, 30, 0.5);
  }
  :global([data-install-page].is-mobile) .ins-cta {
    display: none;
  }
  :global([data-install-page].is-mobile) .ins-mobile {
    display: block;
  }
  .ins-mobile-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--ml-fg) 52%, transparent);
  }
  .ins-mobile-title {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ml-fg);
  }
  .ins-mobile-body {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--ml-muted);
  }
  .ins-mobile-row {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ins-mobile-copy,
  .ins-mobile-share {
    display: inline-flex;
    height: 46px;
    align-items: center;
    padding: 0 20px;
    border-radius: 14px;
    border: 0;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .ins-mobile-copy {
    background: var(--ml-fg);
    color: var(--ml-bg);
  }
  .ins-mobile-share {
    border: 1px solid var(--ml-border);
    background: color-mix(in oklch, var(--ml-card) 70%, transparent);
    color: var(--ml-fg);
  }
  .ins-mobile-copy-done {
    display: none;
    color: var(--pl-green);
  }
  .ins-mobile-copy.is-copied .ins-mobile-copy-idle {
    display: none;
  }
  .ins-mobile-copy.is-copied .ins-mobile-copy-done {
    display: inline;
  }
  .ins-download {
    display: inline-flex;
    height: 60px;
    align-items: center;
    gap: 12px;
    border-radius: 18px;
    background: var(--ml-fg);
    padding: 0 28px;
    font-size: 17px;
    font-weight: 600;
    color: var(--ml-bg);
    transition: transform 0.2s var(--ease-out);
  }
  .ins-download:hover {
    transform: scale(1.02);
    color: var(--ml-bg);
  }
  .ins-download-ic {
    width: 19px;
    height: 19px;
  }
  .ins-cta-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
