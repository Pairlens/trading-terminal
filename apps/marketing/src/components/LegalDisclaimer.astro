---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
// Fine-print risk & liability disclaimer, shared by every footer variant so the
// same notice appears on the landing, docs, and affiliates pages. Copy lives in
// `LEGAL_DISCLAIMER` (single source of truth) in @/lib/site.
import { LEGAL_DISCLAIMER } from '@/lib/site'

interface Props {
  /** Extra classes on the wrapper (margins / borders for the host footer). */
  class?: string
  /** Show the small eyebrow heading (used in the full footer, hidden in minimal). */
  showHeading?: boolean
}
const { class: className = '', showHeading = true } = Astro.props
---

<section aria-label="Risk disclosure and terms" class={className}>
  {
    showHeading && (
      <p class="pl-eyebrow text-muted-foreground/60">{LEGAL_DISCLAIMER.heading}</p>
    )
  }
  <div
    class:list={[
      'max-w-[82ch] space-y-2.5 text-xs leading-relaxed text-pretty text-muted-foreground/55',
      showHeading && 'mt-3',
    ]}
  >
    {LEGAL_DISCLAIMER.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
