// The Pairlens wordmark (white letters, black outline, spectrum underline).
// It carries its own outline, so it reads on both the marble and graphite
// grounds without a theme variant.
//
// Imported, not read from public/: that gives the file a content-hashed URL,
// so a brand change ships a new URL rather than new bytes behind the old one.
// Its intrinsic size rides along, which is what the browser uses for the
// aspect ratio before the image lands.
import wordmark from '@/assets/wordmark.webp'

interface Props {
  /** Rendered wordmark height in px. */
  size?: number
  href?: string | null
  class?: string
}

const { size = 28, href = '/', class: className = '' } = Astro.props

const Tag = href ? 'a' : 'div'
---

<Tag
  {...href ? { href } : {}}
  class:list={['inline-flex items-center no-underline', className]}
  aria-label="Pairlens home"
>
  <img
    src={wordmark.src}
    alt="Pairlens"
    width={wordmark.width}
    height={wordmark.height}
    style={`height:${size}px;width:auto`}
    class="block shrink-0 select-none"
    loading="eager"
    decoding="async"
    draggable="false"
  />
</Tag>
