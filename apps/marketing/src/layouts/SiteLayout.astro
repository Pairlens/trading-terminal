---
// Copyright (c) 2026 Juan Ignacio Molina Estrada
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
import '../styles/globals.css'
// Latin subsets of the three DS families, preloaded below. `?url` resolves to
// the same hashed asset the fontsource CSS references, so the browser starts
// the downloads with the HTML instead of after the stylesheet parses — without
// this, slow connections paint fallback text and reflow once per arriving
// family (the laptop under the landing headline visibly jumped on phones).
import hankenWoff2 from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url'
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'
import jetbrainsWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import CookieBanner from '@/components/CookieBanner.astro'
import { SITE } from '@/lib/site'

interface Props {
  title: string
  description?: string
  /** Absolute or root-relative OG image. */
  image?: string
  /** Structured-data JSON-LD object(s) to embed. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>
  noindex?: boolean
  /** Extra classes for <body> (e.g. per-page background treatment). */
  bodyClass?: string
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  jsonLd,
  noindex = false,
  bodyClass = '',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Layout stability: border-box must apply before any async stylesheet
         (else the 1264px shell first lays out ~1330px wide and snaps), and a
         stable scrollbar gutter stops centred containers re-centring when the
         streaming document first overflows the viewport. -->
    <style is:inline>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scrollbar-gutter: stable;
      }
      /* During a view transition the incoming page's stylesheets can land a
         frame late; an inline SVG with only a viewBox then defaults to 100%
         width and paints viewport-sized — "the icon takes the full screen".
         Zero-specificity fallback (any real stylesheet rule wins) keeps
         unstyled icons text-sized for that frame. Inline styles apply
         synchronously with the swap, so this can never itself arrive late. */
      :where(svg:not([width])) {
        width: 1em;
        height: 1em;
      }
    </style>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={hankenWoff2}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={spaceGroteskWoff2}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={jetbrainsWoff2}
    />
    <!-- The hosted terminal is the site's primary CTA and lives on another
         origin, so the click starts with a cold DNS + TCP + TLS handshake.
         Opening it up front costs no bytes and buys back the whole round
         trip; Safari honours this even though it ships neither of the two
         speculative loads below. -->
    <link rel="preconnect" href={SITE.launchUrl} />
    <link rel="dns-prefetch" href={SITE.launchUrl} />
    <!-- Prefetch the terminal's shell document on hover ("moderate"), not on
         load. Same-site cross-origin prefetch needs no opt-in header from the
         target, and unlike a plain `rel=prefetch` this lands in the browser's
         prefetch cache, which activates without revalidating. The shell's
         ~170 chunks are the other 99% of the boot and are warmed separately
         by scripts/terminal-prefetch.ts. -->
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prefetch: [
          {
            source: 'document',
            where: { selector_matches: 'a[data-launch-terminal]' },
            eagerness: 'moderate',
          },
        ],
      })}
    />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#161719" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdArray.map((data) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data)}
        />
      ))
    }

    <ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-screen bg-background font-sans text-foreground antialiased selection:bg-primary/25',
      bodyClass,
    ]}
  >
    <slot />

    <CookieBanner />

    <!-- Analytics renders a <vercel-analytics> custom element. An unknown
         element inside <head> ends head parsing on the spot, and everything
         Astro emits after it — including the page's stylesheet links — is
         re-parented into <body>. Body stylesheets don't block the first
         paint, and ClientRouter can't persist them across a swap (it only
         matches head links by href), so every client-side navigation threw
         the styles away and repainted unstyled until the CSS came back.
         Keep this in the body. -->
    <Analytics />

    <script>
      import '@/scripts/reveal.ts'
      // Pulls in analytics.ts (consent + init) and arms the delegated
      // product-event listeners on top of it.
      import '@/scripts/analytics-events.ts'
      // Warms the hosted terminal's chunks on CTA hover. Imported after
      // analytics because it reports through the same taxonomy.
      import '@/scripts/terminal-prefetch.ts'
    </script>
  </body>
</html>
