{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the Pairlens desktop app",
  "windows": ["main", "splashscreen", "terminal-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:webview:allow-set-webview-focus",
    "websocket:default",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.okx.com/*" },
        { "url": "https://*.binance.com/*" },
        { "url": "https://*.binance.us/*" },
        { "url": "https://testnet.binance.vision/*" },
        { "url": "https://*.binancefuture.com/*" },
        { "url": "https://*.bybit.com/*" },
        { "url": "https://*.bybit.nl/*" },
        { "url": "https://*.bitvavo.com/*" },
        { "url": "https://*.mexc.com/*" },
        { "url": "https://*.kucoin.com/*" },
        { "url": "https://*.kucoin.eu/*" },
        { "url": "https://openapi-sandbox.kucoin.com/*" },
        { "url": "https://*.gateio.ws/*" },
        { "url": "https://*.gateapi.io/*" },
        { "url": "https://*.coinbase.com/*" },
        { "url": "https://*.bitget.com/*" },
        { "url": "https://*.kraken.com/*" },
        { "url": "https://*.huobi.pro/*" },
        { "url": "https://*.crypto.com/*" },
        { "url": "https://*.3ona.co/*" },
        { "url": "https://*.bitfinex.com/*" },
        { "url": "https://*.upbit.com/*" },
        { "url": "https://*.alpaca.markets/*" },
        { "url": "https://*.kalshi.com/*" },
        { "url": "https://*.kalshi.co/*" },
        { "url": "https://*.polymarket.com/*" },
        { "url": "https://*.kyberswap.com/*" },
        { "url": "https://jup.ag/*" },
        { "url": "https://*.jup.ag/*" },
        { "url": "https://*.dexpaprika.com/*" },
        { "url": "https://*.geckoterminal.com/*" },
        { "url": "https://*.publicnode.com/*" },
        { "url": "https://*.solana.com/*" }
      ]
    }
  ]
}
