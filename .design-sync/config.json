{
  "projectId": "8edadd35-889e-4205-b8fc-e6785cfeea52",
  "shape": "package",
  "pkg": "@pairlens/ui",
  "globalName": "PairlensUI",
  "buildCmd": "node .design-sync/prebuild.mjs",
  "entry": "packages/ui/.ds-tmp/bundle-entry.ts",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-tmp/compiled.css",
  "extraFonts": [
    "node_modules/@fontsource-variable/mozilla-text/index.css",
    "node_modules/@fontsource-variable/playfair-display/index.css",
    "node_modules/@fontsource-variable/jetbrains-mono/index.css"
  ],
  "docsDir": "../../.design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single" },
    "AlertDialog": { "cardMode": "single" },
    "Sheet": { "cardMode": "single" },
    "Drawer": { "cardMode": "single" },
    "Popover": { "cardMode": "single" },
    "Tooltip": { "cardMode": "single" },
    "HoverCard": { "cardMode": "single" },
    "DropdownMenu": { "cardMode": "single" },
    "ContextMenu": { "cardMode": "single" },
    "Command": { "cardMode": "single" },
    "Menubar": { "cardMode": "single" },
    "Select": { "cardMode": "single", "primaryStory": "TimeframePicker" },
    "Combobox": { "cardMode": "single", "primaryStory": "PairSearch" },
    "NavigationMenu": { "cardMode": "single", "primaryStory": "MarketsMenu" },
    "Table": { "cardMode": "column" },
    "Sidebar": { "cardMode": "column" },
    "AspectRatio": { "cardMode": "column" },
    "ChartContainer": { "cardMode": "column" },
    "Spinner": { "cardMode": "column" },
    "Toaster": { "cardMode": "column" },
    "ResizablePanelGroup": { "cardMode": "column" },
    "Accordion": { "cardMode": "column" },
    "Collapsible": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "BellIcon": "src/components/ui/bell.tsx",
    "BlocksIcon": "src/components/ui/blocks.tsx",
    "ChartContainer": "src/components/ui/chart.tsx",
    "ChartLineIcon": "src/components/ui/chart-line.tsx",
    "DirectionProvider": "src/components/ui/direction.tsx",
    "HandCoinsIcon": "src/components/ui/hand-coins.tsx",
    "HomeIcon": "src/components/ui/home.tsx",
    "InputOTP": "src/components/ui/input-otp.tsx",
    "LayersIcon": "src/components/ui/layers.tsx",
    "ResizablePanelGroup": "src/components/ui/resizable.tsx",
    "Toaster": "src/components/ui/sonner.tsx",
    "WaypointsIcon": "src/components/ui/waypoints.tsx",
    "WorkflowIcon": "src/components/ui/workflow.tsx"
  }
}
