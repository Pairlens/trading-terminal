  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:plugin-surface": "bun build src/plugin-surface.ts --outfile ../../apps/terminal/public/_sdk/pairlens-ui.js --format esm --external react --external react-dom --external 'react/jsx-runtime' --external 'react/jsx-dev-runtime' --external '@tanstack/react-query' --target browser --minify",
