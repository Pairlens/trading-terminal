# Root local env file used by all apps and all git worktrees.
# Do not create app-level .env.local files.
#
# Everything here is OPTIONAL — `bun run dev` works with zero configuration.
# The terminal runs fully standalone: market data streams directly from
# exchanges via connector plugins, and persistence is local by default.
#
# Optional cloud features (auth, remote persistence, hosted AI) come from the
# App Server, which is not part of this repo. When one runs locally the dev
# script auto-detects it on localhost:4046 — no env needed.

# ============================================================================
# TERMINAL — Vite env vars (baked into the frontend build)
# ============================================================================

# App Server URL for auth, AI, and remote persistence. When unset, the dev
# script probes http://localhost:4046 for a locally running App Server and
# otherwise starts the terminal in standalone mode (auth off).
# Set explicitly to point at a remote deployment.
# VITE_APP_SERVER_URL=https://api.pairlens.finance

# Plugin Registry URL. Auto-derived for local dev.
# VITE_REGISTRY_URL=http://localhost:3005

# PostHog product analytics + error tracking (terminal). Analytics is opt-in
# (onboarding step / settings toggle) and fully disabled when the key is unset.
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# MARKETING — Astro env vars (baked into the static build)
# ============================================================================

# PostHog for pairlens.finance. Loaded only after cookie-banner consent;
# fully disabled when the key is unset.
# PUBLIC_POSTHOG_KEY=phc_your_project_key
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# DEVELOPMENT HELPERS
# ============================================================================

# Deterministic worktree ports (for parallel git worktree dev).
# Each worktree gets its own 6-port slot derived from its path.
# TERMINAL_PORT=3000
# MARKETING_PORT=3003
# REGISTRY_PORT=3005
# PAIRLENS_WORKTREE_PORTS=1
# PAIRLENS_PORT_BASE=3000
# PAIRLENS_PORT_SPAN=500
